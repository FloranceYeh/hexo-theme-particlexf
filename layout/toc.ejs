<%
    var hasComments = page.comments && (
        theme.gitalk.enable ||
        theme.giscus.enable ||
        theme.waline.enable ||
        theme.twikoo.enable
    );
%>
<% if (page.toc !== false && toc(page.content)) { %>
<aside class="toc-sidebar" id="toc-sidebar" aria-label="<%= __('toc') %>">
    <div class="toc-panel" id="toc-panel">
        <div class="toc-panel-header">
            <div class="toc-header">
                <i class="fa-solid fa-list"></i> <%= __('toc') %>
            </div>
            <button type="button" class="toc-close" id="toc-close" aria-label="<%= __('close_toc') %>">
                <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="toc-wrapper" id="toc-wrapper">
            <%- toc(page.content, { class: 'toc', list_number: true }) %>
        </div>
        <div class="toc-nav-buttons">
            <a href="javascript:;" class="toc-btn" id="toc-btn-top" title="<%= __('back_to_top') %>">
                <i class="fa-solid fa-arrow-up"></i> <%= __('back_to_top') %>
            </a>
            <a href="<%= hasComments ? '#comment' : '#footer' %>" class="toc-btn" id="toc-btn-comment" title="<%= hasComments ? __('view_comments') : __('go_to_bottom') %>">
                <i class="fa-solid <%= hasComments ? 'fa-comments' : 'fa-arrow-down' %>"></i> <%= hasComments ? __('comments') : __('bottom') %>
            </a>
        </div>
    </div>
</aside>
<button type="button" class="toc-fab" id="toc-fab" aria-label="<%= __('open_toc') %>" aria-controls="toc-sidebar" aria-expanded="false">
    <i class="fa-solid fa-list" aria-hidden="true"></i>
    <span><%= __('toc') %></span>
</button>
<% } %>
